from __future__ import annotations

from typing import Any, List, Literal, overload
from SymfWebAPI.client import SyncAPI
from SymfWebAPI.protocols import (SyncInvokerProtocol, SyncRequestProtocol)
from SymfWebAPI.response import ResponseEnvelope
from SymfWebAPI.WebAPI.Interface.Common.ViewModels import Dimension
from .json_types import DimensionJSON

@overload
def Get(api: SyncAPI, productId: int, *, validate: Literal[True] = True) -> ResponseEnvelope[List[Dimension]]: ...
@overload
def Get(api: SyncAPI, productId: int, *, validate: Literal[False]) -> ResponseEnvelope[list[DimensionJSON]]: ...
@overload
def Get(api: SyncInvokerProtocol, productId: int, *, validate: Literal[True] = True) -> ResponseEnvelope[List[Dimension]]: ...
@overload
def Get(api: SyncInvokerProtocol, productId: int, *, validate: Literal[False]) -> ResponseEnvelope[list[DimensionJSON]]: ...
@overload
def Get(api: SyncRequestProtocol, productId: int, *, validate: Literal[True] = True) -> ResponseEnvelope[List[Dimension]]: ...
@overload
def Get(api: SyncRequestProtocol, productId: int, *, validate: Literal[False]) -> ResponseEnvelope[list[DimensionJSON]]: ...
@overload
def Get(api: SyncAPI, productCode: str, *, validate: Literal[True] = True) -> ResponseEnvelope[List[Dimension]]: ...
@overload
def Get(api: SyncAPI, productCode: str, *, validate: Literal[False]) -> ResponseEnvelope[list[DimensionJSON]]: ...
@overload
def Get(api: SyncInvokerProtocol, productCode: str, *, validate: Literal[True] = True) -> ResponseEnvelope[List[Dimension]]: ...
@overload
def Get(api: SyncInvokerProtocol, productCode: str, *, validate: Literal[False]) -> ResponseEnvelope[list[DimensionJSON]]: ...
@overload
def Get(api: SyncRequestProtocol, productCode: str, *, validate: Literal[True] = True) -> ResponseEnvelope[List[Dimension]]: ...
@overload
def Get(api: SyncRequestProtocol, productCode: str, *, validate: Literal[False]) -> ResponseEnvelope[list[DimensionJSON]]: ...
