from __future__ import annotations

from typing import Any, List, Literal, overload
from datetime import datetime
from SymfWebAPI.client import SyncAPI
from SymfWebAPI.protocols import (SyncInvokerProtocol, SyncRequestProtocol)
from SymfWebAPI.response import ResponseEnvelope
from SymfWebAPI.WebAPI.Interface.FKF.Common.ViewModels import Year
from .json_types import YearJSON

@overload
def Get(api: SyncAPI, *, validate: Literal[True] = True) -> ResponseEnvelope[List[Year]]: ...
@overload
def Get(api: SyncAPI, *, validate: Literal[False]) -> ResponseEnvelope[list[YearJSON]]: ...
@overload
def Get(api: SyncInvokerProtocol, *, validate: Literal[True] = True) -> ResponseEnvelope[List[Year]]: ...
@overload
def Get(api: SyncInvokerProtocol, *, validate: Literal[False]) -> ResponseEnvelope[list[YearJSON]]: ...
@overload
def Get(api: SyncRequestProtocol, *, validate: Literal[True] = True) -> ResponseEnvelope[List[Year]]: ...
@overload
def Get(api: SyncRequestProtocol, *, validate: Literal[False]) -> ResponseEnvelope[list[YearJSON]]: ...
@overload
def Get(api: SyncAPI, date: datetime, *, validate: Literal[True] = True) -> ResponseEnvelope[Year]: ...
@overload
def Get(api: SyncAPI, date: datetime, *, validate: Literal[False]) -> ResponseEnvelope[YearJSON]: ...
@overload
def Get(api: SyncInvokerProtocol, date: datetime, *, validate: Literal[True] = True) -> ResponseEnvelope[Year]: ...
@overload
def Get(api: SyncInvokerProtocol, date: datetime, *, validate: Literal[False]) -> ResponseEnvelope[YearJSON]: ...
@overload
def Get(api: SyncRequestProtocol, date: datetime, *, validate: Literal[True] = True) -> ResponseEnvelope[Year]: ...
@overload
def Get(api: SyncRequestProtocol, date: datetime, *, validate: Literal[False]) -> ResponseEnvelope[YearJSON]: ...
